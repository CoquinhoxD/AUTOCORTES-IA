{
  "name": "viral-cut-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ferramenta de cortes automáticos para vídeos longos com IA",
  "engines": {
    "node": ">=18.20"
  },
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,cyan\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "doctor": "npm run doctor --prefix backend",
    "prisma:setup": "npm run prisma:setup --prefix backend",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
