{
  "name": "viral-cut-ai-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.20"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "node ./scripts/doctor.js",
    "typecheck": "tsc --noEmit",
    "prisma:setup": "prisma db push && prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma db push --force-reset"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.0",
    "@prisma/client": "^5.6.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.28.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.6.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
