# ==========================================
# VIRAL CUT AI — Configuração
# Copie este arquivo: cp backend/.env.example backend/.env
# NUNCA envie o .env com chaves reais para o Git.
# ==========================================

# ---------- Banco de dados ----------
DATABASE_URL="file:./dev.db"

# ---------- Análise com IA ----------
# O provider é deduzido do formato da chave (gsk_ = Groq, sk- = OpenAI).
# Para explicitar, defina AI_PROVIDER=groq|openai
#
# Modelos Groq recomendados (https://console.groq.com/docs/models):
#   llama-3.3-70b-versatile     (melhor custo-benefício)
#   llama-3.1-8b-instant        (mais rápido)
#   openai/gpt-oss-120b         (alternativa aberta)
#
# Modelos OpenAI:
#   gpt-4o
#   gpt-4o-mini
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# ---------- Transcrição (Whisper) ----------
# TRANSCRIPTION_PROVIDER aceita: groq | openai | local
# "local" usa whisper.cpp / faster-whisper instalado na máquina (sem limite de tamanho)
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3

# ---------- Upload ----------
# Limite máximo de vídeo em MB. 5120 = 5 GB.
MAX_VIDEO_SIZE_MB=5120

# ---------- Servidor ----------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------- Fila (futuro BullMQ + Redis) ----------
# JOB_QUEUE_NAME=viral-cut-processing
# REDIS_URL=redis://localhost:6379
